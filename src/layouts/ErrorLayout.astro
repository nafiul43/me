---
import "../styles/fonts.css";
import "@fontsource/material-icons";
import "../styles/global.css";
import ThemeToggle from "../components/theme-toggole.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title = "404 - Page Not Found | Nafiul Islam Tony",
  description = "The page you're looking for doesn't exist.",
  image = `${import.meta.env.PUBLIC_CDN_BASE_URL}/Nafiul+Islam+Tony+-+FrontEnd+Lead+Fullstack+Engineer.webp`,
  canonical = Astro.url.pathname,
} = Astro.props;

const siteUrl = Astro.site || "https://nafiulislam.site";
const canonicalURL = new URL(canonical, siteUrl).href;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Theme Color -->
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#1a202c"
      media="(prefers-color-scheme: dark)"
    />

    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />

    <!-- Theme handling - must be in head to prevent FOUC -->
    <script is:inline>
      (function () {
        // Default to dark mode if nothing is set in localStorage
        const t =
          (typeof localStorage !== "undefined" &&
            localStorage.getItem("theme")) ||
          "dark";
        document.documentElement.classList[t === "dark" ? "add" : "remove"](
          "dark",
        );
        try {
          localStorage.setItem("theme", t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-gray-50 dark:bg-gray-900">
    <div class="starfield fixed inset-0 z-0 pointer-events-none">
      <div class="stars"></div>
      <div class="stars2"></div>
      <div class="stars3"></div>
    </div>
    <div class="flex justify-center min-h-screen relative z-10">
      <main class="w-full max-w-5xl px-4 py-8">
        <slot />
      </main>
      <ThemeToggle />
    </div>

    <script>
      import { updateThemeColor } from "../utils/init-theme";
      import { lazyLoadStyles } from "../utils/lazy-load-styles";

      // Lazy load CSS files
      lazyLoadStyles(["/styles/starfield.css", "/styles/404.css"]);

      // Update theme-color meta tag
      document.addEventListener("DOMContentLoaded", () => {
        updateThemeColor();
      });
    </script>

    <style>
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
        font-family: Inter, "Helvetica Neue", "Arial Nova", "Nimbus Sans", Arial,
          sans-serif;
      }
    </style>
  </body>
</html>
