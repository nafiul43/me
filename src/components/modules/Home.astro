---
import SectionCard from "@components/section-card.astro";
import { ABOUT } from "@data/about";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

const { title, subtitle, location, bio, profilePic, links, openTo } =
  ABOUT || {};
---

<SectionCard
  slug="profile"
  className="scroll-mt-16 flex flex-col md:flex-row gap-x-0 gap-y-6 md:gap-x-6 lg:gap-y-0"
>
  <div class="flex items-center gap-4 sm:flex-row md:flex-col">
    <Image
      format="webp"
      fit="cover"
      src={profilePic}
      loading="lazy"
      fetchpriority="high"
      decoding="async"
      width={320}
      height={320}
      alt={`${title}, ${subtitle}`}
      class="rounded-lg h-24 max-w-none md:h-52 md:w-52 h-36 w-36"
    />
    <a
      href="/Resume.pdf"
      class="w-48 text-sm sm:text-base md:w-full font-medium items-center justify-center active:translate-y-px bg-primary-700 cursor-pointer focus:outline-none h-10 hover:bg-primary-700 inline-flex px-4 rounded-md select-none shadow-sm text-white"
      aria-label={`Download ${title}'s Resume PDF`}
      download="Resume of Nafiul Islam Tony.pdf"
      >Download Resume
    </a>
  </div>
  <div class="flex w-full flex-col gap-5">
    <div class="flex w-full flex-col justify-between gap-y-2">
      <div class="flex justify-between flex-col md:flex-row gap-y-2 md:gap-y-0">
        <div class="w-full flex flex-col">
          <h1
            class="text-gray-900 dark:text-gray-100 font-extrabold text-3xl sm:text-4xl"
          >
            {title}
          </h1>
          <h4
            class="font-medium text-gray-700 dark:text-gray-100 sm:text-lg text-base"
          >
            {subtitle}
          </h4>
        </div>
        <div class="flex gap-x-2">
          {
            links.map((link) => (
              <a
                href={link.href}
                class="flex items-center bg-gray-100 hover:bg-primary-700 hover:text-white rounded active:translate-y-px dark:bg-gray-600 dark:text-gray-200 focus:outline-none h-7 justify-center text-gray-400 w-7"
                aria-label={`${link.slug} section`}
                data-tooltip={link.slug}
                data-tooltip-placement="bottom"
                target={link.target}
              >
                <Icon name={link.icon} size={20} />
              </a>
            ))
          }
        </div>
      </div>

      <div class="inline-grid xl:grid-cols-[auto_auto] my-2">
        {
          links.map((link) => (
            <div class="flex gap-x-3">
              <span class="font-medium text-gray-700 dark:text-gray-300 text-base">
                {link.title}
              </span>
              <a
                href={link.href}
                class="dark:text-gray-300 text-sm font-normal text-gray-500 leading-relaxed sm:leading-relaxed sm:text-base"
                target="_self"
              >
                {link.value}
              </a>
            </div>
          ))
        }
        <div class="flex gap-x-3">
          <span class="font-medium text-gray-700 dark:text-gray-300 text-base">
            From
          </span>
          <span
            class="dark:text-gray-300 text-sm font-normal text-gray-500 leading-relaxed sm:leading-relaxed sm:text-base"
          >
            {location}
          </span>
        </div>
      </div>
      <p
        class="dark:text-gray-300 text-sm font-normal text-gray-500 leading-relaxed sm:leading-relaxed sm:text-base"
      >
        {bio}
      </p>
      <div class="flex flex-wrap gap-2 mt-4">
        {
          openTo.map((open) => (
            <span class="flex items-center bg-gray-100 rounded dark:bg-gray-700 dark:text-gray-100 font-medium gap-x-1.5 h-6 px-2.5 text-gray-700 text-sm tracking-wide w-fit dark:hover:bg-gray-600 hover:bg-gray-200 cursor-pointer">
              {open}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</SectionCard>
