---
import ProfilePhoto from "@assets/PP.jpg";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

const links = [
  {
    slug: "phone",
    href: "tel:+8801672219915",
    icon: "mdi:phone",
    title: "Phone",
    value: "+8801672219915",
    target: "_self",
  },
  {
    slug: "email",
    href: "mailto:nafiul.islam.tony@gmail.com",
    icon: "mdi:email",
    title: "Email",
    value: "nafiul.islam.tony@gmail.com",
    target: "_self",
  },
  {
    slug: "linkedin",
    href: "https://www.linkedin.com/in/nafiul/",
    icon: "mdi:linkedin",
    title: "LinkedIn",
    value: "nafiul",
    target: "_blank",
  },
];
---

<section
  id="home"
  class="flex gap-x-6 w-full p-6 rounded-xl bg-white dark:bg-gray-800 shadow-sm"
>
  <div class="flex items-center gap-4 sm:flex-col">
    <Image
      format="webp"
      fit="cover"
      src={ProfilePhoto}
      loading="eager"
      width={320}
      height={320}
      alt="Profile Photo"
      class="rounded-lg h-24 max-w-none md:h-52 md:w-52 sm:h-36 sm:w-36 w-24"
    />
    <a
      href="#"
      class="w-full font-medium items-center justify-center active:translate-y-px bg-primary-900 cursor-pointer focus:outline-none h-10 hover:bg-primary-700 inline-flex px-4 rounded-md select-none shadow-sm text-base text-white"
      >Download Resume</a
    >
  </div>
  <div class="flex w-full flex-col gap-5">
    <div class="flex w-full flex-col justify-between gap-y-2">
      <div class="flex justify-between">
        <div class="w-full flex flex-col">
          <h1
            class="text-gray-900 dark:text-gray-100 font-extrabold text-3xl sm:text-4xl"
          >
            Nafiul Islam Tony
          </h1>
          <h4
            class="font-medium text-gray-700 dark:text-gray-100 sm:text-lg text-base"
          >
            Frontend Lead | Full Stack Engineer
          </h4>
        </div>
        <div class="flex gap-x-2">
          {
            links.map((link) => (
              <a
                href={link.href}
                class="flex items-center bg-gray-100 hover:bg-primary-700 rounded active:translate-y-px dark:bg-gray-600 dark:text-gray-200 focus:outline-none h-7 justify-center text-gray-400 w-7"
                aria-label={`${link.slug} section`}
                data-tooltip={link.slug}
                data-tooltip-placement="bottom"
                target={link.target}
              >
                <Icon name={link.icon} size={20} />
              </a>
            ))
          }
        </div>
      </div>

      <div class="inline-grid xl:grid-cols-[auto_auto] my-2">
        {
          links.map((link) => (
            <div>
              <span class="font-medium text-gray-700 dark:text-gray-300 text-base">
                {link.title}
              </span>
              <a
                href={link.href}
                class="dark:text-gray-300 text-sm font-normal text-gray-500 leading-relaxed sm:leading-relaxed sm:text-base"
                target="_self"
              >
                {link.value}
              </a>
            </div>
          ))
        }
        <div>
          <span class="font-medium text-gray-700 dark:text-gray-300 text-base">
            From
          </span>
          <span
            class="dark:text-gray-300 text-sm font-normal text-gray-500 leading-relaxed sm:leading-relaxed sm:text-base"
          >
            Dhaka, Bangladesh
          </span>
        </div>
      </div>
      <p
        class="dark:text-gray-300 text-sm font-normal text-gray-500 leading-relaxed sm:leading-relaxed sm:text-base"
      >
        Engineering Leader with over 13 years of experience shaping SaaS
        platforms and consumer apps at startups like klikit and Pathao. Built
        design systems with React, Vue, Storybook, and Rollup, adopted across
        25+ products, scaled PayLater to millions under tight deadlines, and led
        teams that shipped regularly. Now eager to bring that speed to creative
        tech and AI-driven products
      </p>
    </div>
  </div>
</section>
