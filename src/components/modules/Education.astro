---
import duLogo from "@assets/schools/du.webp";
import SectionCard from "@components/section-card.astro";
import { Image } from "astro:assets";

const schools = [
  {
    institute: "University of Dhaka",
    degree: "Master of Science in Computer Science & Engineering",
    logo: duLogo,
    logoAlt: "University of Dhaka",
    logoFit: "contain",
    date: "October 2012 - December 2014",
  },
  {
    institute: "University of Dhaka",
    degree: "Bachelor of Science (Honours) in Computer Science & Engineering",
    logo: duLogo,
    logoAlt: "University of Dhaka",
    logoFit: "contain",
    date: "March 2008 - August 2012",
  },
];
---

<SectionCard slug="education" className="scroll-mt-8 gap-y-4 flex-col">
  <h1 class="text-gray-900 dark:text-gray-100 font-extrabold text-3xl">
    Education
  </h1>

  <div
    class="flex flex-col gap-y-4 divide-gray-100 dark:divide-gray-700 divide-y-2"
  >
    {
      schools.map((school) => {
        return (
          <div class="flex gap-y-4">
            <div class="flex gap-x-4 my-4">
              <Image
                format="webp"
                fit={school.logoFit}
                src={school.logo}
                loading="lazy"
                width={100}
                height={125}
                alt={school.logoAlt}
                class="border border-gray-200 dark:border-none rounded-lg w-12 h-[60px] max-w-none md:h-20 md:w-16 sm:h-[60px] sm:w-12"
              />
              <div class="flex flex-col justify-center gap-y-1">
                <h3 class="text-gray-900 dark:text-gray-100 font-extrabold text-xl -mt-1">
                  {school.degree}
                </h3>
                <p class="text-gray-900 dark:text-gray-100 font-semibold leading-snug text-base">
                  {school.institute}
                </p>
                <p class="font-medium text-gray-700 text-sm dark:text-gray-100">
                  {school.date}
                </p>
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</SectionCard>
