---
import SectionCard from "@components/section-card.astro";
import { SKILLS } from "@data/skills";
import { Icon } from "astro-icon/components";
---

<SectionCard slug="skills" className="scroll-mt-8 gap-y-4 flex-col">
  <h1 class="text-gray-900 dark:text-gray-100 font-extrabold text-3xl">
    Skills
  </h1>

  <div
    class="flex flex-col gap-y-4 divide-gray-100 dark:divide-gray-700 divide-y-2"
  >
    {
      Object.keys(SKILLS).map((key) => {
        return (
          <div class="flex flex-col gap-y-4 pb-4">
            <h3 class="text-gray-900 dark:text-gray-100 font-extrabold text-lg">
              {SKILLS[key].title}
            </h3>
            <div class="flex flex-wrap gap-2">
              {SKILLS[key].stacks.map((tech) => {
                return (
                  <div class="flex items-center bg-gray-100 rounded dark:bg-gray-700 dark:text-gray-100 font-medium gap-x-1.5 h-6 px-2.5 text-gray-700 text-sm tracking-wide w-fit dark:hover:bg-gray-600 hover:bg-gray-200 cursor-pointer">
                    <Icon name={tech.icon} size={16} color={tech.color} />
                    {tech.title}
                  </div>
                );
              })}
            </div>
          </div>
        );
      })
    }

    <div class="flex flex-col gap-y-4 pb-4">
      <h3 class="text-gray-900 dark:text-gray-100 font-extrabold text-lg">
        I speak
      </h3>
      <div
        class="flex items-center bg-gray-100 rounded dark:bg-gray-700 dark:text-gray-100 font-medium gap-x-1.5 h-6 px-2.5 text-gray-700 text-sm tracking-wide w-fit dark:hover:bg-gray-600 hover:bg-gray-200 cursor-pointer"
      >
        <Icon name="mdi:web" size={16} />
        English - C1
      </div>
    </div>
  </div>
</SectionCard>
