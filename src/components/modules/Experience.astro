---
import SectionCard from "@components/section-card.astro";
import { Image } from "astro:assets";

import { JOBS } from "@data/jobs";
import { Icon } from "astro-icon/components";
---

<SectionCard slug="experience" className="scroll-mt-8 gap-y-4 flex-col">
  <h1 class="text-gray-900 dark:text-gray-100 font-extrabold text-3xl">
    Work Experience
  </h1>

  <div
    class="flex flex-col gap-y-4 divide-gray-100 dark:divide-gray-700 divide-y-2"
  >
    {
      JOBS.map((job, jobIndex) => {
        return (
          <div class="flex flex-col gap-y-4">
            <div class="flex gap-x-4 mt-4">
              <Image
                format="webp"
                fit={job.logo.fit || "cover"}
                src={job.logo.src}
                loading={jobIndex > 1 ? "lazy" : "eager"}
                width={100}
                height={100}
                alt={job.company}
                class="border border-gray-200 dark:border-none rounded-lg w-12 h-12 max-w-none md:h-16 md:w-16 sm:h-12 sm:w-12"
              />
              <div class="w-full flex justify-between">
                <div class="gap-y-1">
                  <h3 class="text-gray-900 dark:text-gray-100 font-extrabold text-xl -mt-1">
                    {job.company}
                  </h3>
                  <p class="text-gray-900 dark:text-gray-100 font-semibold leading-snug mb-0.5 text-base">
                    {job.position}
                  </p>
                  <p class="font-medium text-gray-700 text-sm dark:text-gray-100">
                    {job.date}
                  </p>
                </div>
                <div class="flex gap-x-2">
                  {job.links?.map((link) => (
                    <a
                      href={link.href}
                      class="flex items-center bg-gray-100 hover:bg-primary-700 hover:text-white rounded active:translate-y-px dark:bg-gray-600 dark:text-gray-200 focus:outline-none h-7 justify-center text-gray-400 w-7"
                      aria-label={`${link.slug} section`}
                      data-tooltip={link.slug}
                      data-tooltip-placement="bottom"
                      target={link.target}
                    >
                      <Icon name={link.icon} size={20} />
                    </a>
                  ))}
                </div>
              </div>
            </div>
            <div class="dark:text-gray-300 text-xs font-normal text-gray-500 sm:text-base description mb-4">
              <ul class="list-disc ml-6">
                {job.responsibilities.map((responsibility) => {
                  return <li>{responsibility}</li>;
                })}
              </ul>
            </div>
          </div>
        );
      })
    }
  </div>
</SectionCard>
