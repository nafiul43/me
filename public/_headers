# =============================================================================
# STATIC ASSETS CACHING CONFIGURATION
# =============================================================================
# This file configures HTTP cache headers for Cloudflare Pages/Netlify/S3
# Optimized for Astro static site with self-hosted fonts

# =============================================================================
# ASTRO BUILD ASSETS - Cache for 1 year (content-hashed)
# =============================================================================
# Astro generates hashed filenames in _astro/ directory
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# =============================================================================
# FONTS (All formats) - Cache for 1 year (immutable)
# =============================================================================
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable
/*.ttf
  Cache-Control: public, max-age=31536000, immutable
/*.otf
  Cache-Control: public, max-age=31536000, immutable
/*.eot
  Cache-Control: public, max-age=31536000, immutable

# =============================================================================
# IMAGES - Cache for 1 year (immutable)
# =============================================================================
# Favicons and icons
/favicon.ico
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

# Image formats (all locations)
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.gif
  Cache-Control: public, max-age=31536000, immutable
/*.avif
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable

# =============================================================================
# DOCUMENTS - Cache for 1 week
# =============================================================================
/Resume.pdf
  Cache-Control: public, max-age=604800
/*.pdf
  Cache-Control: public, max-age=604800

# =============================================================================
# CODE BUNDLES - Cache for 1 year (Astro adds content hashes)
# =============================================================================
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.mjs
  Cache-Control: public, max-age=31536000, immutable
/*.map
  Cache-Control: public, max-age=31536000, immutable

# =============================================================================
# HTML - Cache for 1 hour with revalidation
# =============================================================================
/
  Cache-Control: public, max-age=3600, must-revalidate
/index.html
  Cache-Control: public, max-age=3600, must-revalidate
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# =============================================================================
# SPECIAL FILES - Short cache
# =============================================================================
# robots.txt - Cache for 1 day (may need updates)
/robots.txt
  Cache-Control: public, max-age=86400

# Sitemaps - Cache for 1 day (regenerated on build)
/sitemap-index.xml
  Cache-Control: public, max-age=86400
/sitemap-*.xml
  Cache-Control: public, max-age=86400

# Manifest files - Cache for 1 week
/*.json
  Cache-Control: public, max-age=604800
/*.webmanifest
  Cache-Control: public, max-age=604800

# =============================================================================
# SECURITY HEADERS (Applied to all routes)
# =============================================================================
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://browser.sentry-cdn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.nafiulislam.site; font-src 'self' data:; connect-src 'self' https://o4508457969270784.ingest.us.sentry.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
